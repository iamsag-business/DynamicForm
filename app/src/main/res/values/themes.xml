<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.DynamicForm" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>

        <item name="android:colorBackground">@color/screen_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:fontFamily">sans</item>

        <item name="colorError">#D32F2F</item>
        <item name="colorOnError">#FFFFFF</item>

    </style>

    <style name="Theme.DynamicForm" parent="Base.Theme.DynamicForm" />


    <style name="FormButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
